# Copy to .env and adjust
DATABASE_URL="postgresql://babypleats_db_user:pSbagjNWBLkSZUWuzDXjOvMoaLtD9DQl@dpg-davt2fijnfac73d28jd0-a/babypleats_db"
PORT=4000
# Comma-separated browser origins allowed to call the API.
# Localhost / 127.0.0.1 on any port are also allowed automatically by the server.
# Production Render example:
# CORS_ORIGIN="https://babypleats.in,https://admin.babypleats.in,<storefront-render-url>,<admin-render-url>"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,https://babypleats.in,https://admin.babypleats.in"
# Required for admin JWT auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=8h
# Used only to create the owner on first boot if that email does not exist yet
ADMIN_EMAIL="owner@babypleats.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Baby Pleats Admin"
# Required for POST /v1/media/upload (server-side signed upload uses key+secret)
# Production client cloud name example: mdqbllsu
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional for signed server uploads. If set, must exist on THIS cloud.
# Prefer a signed preset, or leave empty and rely on API key/secret only.
CLOUDINARY_UPLOAD_PRESET=
# Destination folder on this cloud (created on upload if missing)
CLOUDINARY_FOLDER=babypleats
# Optional: error tracking (leave empty to disable)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
NODE_ENV=development
# Checkout / Razorpay (required for Pay online)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional shipping overrides (defaults match the storefront)
FREE_SHIPPING_THRESHOLD=999
SHIPPING_FEE=99

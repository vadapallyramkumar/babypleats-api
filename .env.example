# Copy to .env and adjust
DATABASE_URL="postgresql://babypleats:babypleats@localhost:5432/babypleats?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
# Required for admin JWT auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=8h
# Used only to create the owner on first boot if that email does not exist yet
ADMIN_EMAIL="owner@babypleats.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Baby Pleats Admin"
# Required for POST /v1/media/upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=babypleates/products

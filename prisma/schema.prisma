generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  image       String
  description String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  /// Merchandising filter: budgetFriendly | readyToDispatch | bestseller
  filter      String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String   @id
  slug           String   @unique
  name           String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  subcategory    String?
  description    String
  fabric         String?
  care           String   @default("[]")
  images         String
  colorGalleries String   @default("[]")
  variants       String
  isNew          Boolean  @default(false)
  featured       Boolean  @default(false)
  isActive       Boolean  @default(true)
  rating         Float?
  reviewsCount   Int?
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum SocialMediaType {
  image
  video
}

model HeroImage {
  id        String   @id @default(uuid())
  url       String
  mobileUrl String?
  alt       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionalMessage {
  id        String   @id @default(uuid())
  message   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String          @id @default(uuid())
  url       String
  type      SocialMediaType
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

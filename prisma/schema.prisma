generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id
  slug        String    @unique
  name        String
  image       String
  description String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  /// Merchandising filter: budgetFriendly | readyToDispatch | bestseller
  filter      String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String   @id
  slug           String   @unique
  name           String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  subcategory    String?
  description    String
  fabric         String?
  care           String   @default("[]")
  images         String
  colorGalleries String   @default("[]")
  variants       String
  isNew          Boolean  @default(false)
  featured       Boolean  @default(false)
  isActive       Boolean  @default(true)
  rating         Float?
  reviewsCount   Int?
  tags           String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum SocialMediaType {
  image
  video
}

model HeroImage {
  id        String   @id @default(uuid())
  url       String
  mobileUrl String?
  alt       String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PromotionalMessage {
  id        String   @id @default(uuid())
  message   String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String          @id @default(uuid())
  url       String
  type      SocialMediaType
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum OrderStatus {
  pending_payment
  new
  confirmed
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  cod
  razorpay
}

enum PaymentStatus {
  pending
  paid
  failed
}

model Order {
  id                String        @id
  seq               Int           @unique
  status            OrderStatus
  source            String        @default("website")
  customerName      String
  customerEmail     String
  customerPhone     String
  address           String
  city              String
  state             String
  pincode           String
  notes             String?
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(pending)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?
  subtotal          Float
  shipping          Float
  total             Float
  currency          String        @default("INR")
  discount          Float         @default(0)
  couponCode        String?
  couponId          String?
  coupon            Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  stockApplied      Boolean       @default(false)
  items             OrderItem[]
  redemption        CouponRedemption?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod, paymentStatus])
  @@index([customerPhone])
  @@index([couponId])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  variantId   String
  productName String
  sku         String?
  size        String?
  color       String?
  qty         Int
  unitPrice   Float

  @@index([orderId])
  @@index([productId])
}

enum CouponType {
  percent
  fixed
}

model Coupon {
  id              String              @id @default(uuid())
  code            String              @unique
  type            CouponType
  value           Float
  minSubtotal     Float?
  maxDiscount     Float?
  startsAt        DateTime?
  endsAt          DateTime?
  maxRedemptions  Int?
  maxPerCustomer  Int?
  isActive        Boolean             @default(true)
  redemptionCount Int                 @default(0)
  orders          Order[]
  redemptions     CouponRedemption[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  phone     String
  createdAt DateTime @default(now())

  @@index([couponId, phone])
}
